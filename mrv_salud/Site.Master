<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="mrv_salud.Site" %>

<!DOCTYPE html>

<html>
  <head runat="server"><!-- ENCABEZADO -->
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/><!-- ENCABEZADO -->
      <title>Portal Web | Sistema de Citas | MRV Salud</title>
      <asp:ContentPlaceHolder ID="head" runat="server"><!-- ENCABEZADO --> 
      </asp:ContentPlaceHolder><!-- ENCABEZADO -->
       <link href="<%= ResolveUrl("~/Styles/Styles.css") %>" rel="stylesheet" />

</head>

<body>
    <form id="form1" runat="server"><!-- Aquí irá el panel de anuncios --> 
         <header class="site_header">

     <!-- Panel de información -->
         <div class="panel_anuncio">
             <div class="panel">
             <a href="contacto.html">
                 <img src="<%= ResolveUrl("~/Images/telefono.svg") %>" /><!-- Panel de información -->
                 <span>Emergencias: <strong>+504 2234-5555</strong></span>
             </a>
             <span class="separador">|</span>
             <a href="#">
                 <img src="<%= ResolveUrl("~/Images/horario.svg") %>" />
                 <span>Atención: Lun–Sáb, 7:00 a.m. – 7:00 p.m.</span>
             </a>
            </div>
         </div>
   

     <!-- Encabezado principal -->
     <div class="encabezado">
         <!-- Logo -->
         <a href="<%= ResolveUrl("~/Pages/Default.aspx") %>">
         <img  src="<%= ResolveUrl("~/Images/logo-centromedico.svg") %>"alt="Logo Centro Médico MRV Salud" class="logo-hospital" height="50"/>
         </a>

         <!-- Menú de navegación -->
         <nav class="nav-principal" id="navPrincipal">
             <a href="<%= ResolveUrl("~/Pages/Default.aspx") %>">Inicio</a>
             <a href="<%= ResolveUrl("~/Pages/Especialidades.aspx") %>">Especialidades</a>
             <a href="<%= ResolveUrl("~/Pages/Especialistas.aspx") %>">Especialistas</a>
             <a href="<%= ResolveUrl("~/Pages/ConsultarCita.aspx") %>">Consultar cita</a>
             <a href="<%= ResolveUrl("~/Pages/Contacto.aspx") %>">Contacto</a>
         </nav>

         <!-- Acciones del usuario -->
         <div class="acciones-usuario">
             <a class="btn-agendar" href="<%= ResolveUrl("~/Pages/AgendarCita.aspx") %>">
              
                 <img src="<%= ResolveUrl("~/Images/calendario.svg") %>" alt="Icono calendario" class="icono-btn">
                 <span>Agendar una cita</span>
             </a>

             <a class="btn-login" href="<%= ResolveUrl("~/Pages/Login.aspx") %>">
                 <img src="<%= ResolveUrl("~/Images/usuario.svg") %>" alt="Icono usuario" class="icono-login">
                 <span>Inicia sesión</span>
             </a>
             <!-- son las tres lineas que aparecen solo en las pantallas pequeñas para desplegar el menu de nav -->
             <button type="button" class="menu-toggle" id="menuToggle" aria-label="Abrir menú" aria-expanded="false">
                 <span></span>
                 <span ></span>
                 <span></span>
             </button>
         </div>
     </div>
 </header>

<!-- contenedor principal -->
        <div>
            <asp:ContentPlaceHolder ID="contenido_principal" runat="server">





            </asp:ContentPlaceHolder>
        </div>


        <!-- despues del contenedor del contenido principal, colocamos el pie de pagina -->
         <!-- PIE DE PÁGINA -->


    <footer class="pie_pagina">
        <div class="pie_contenido">
            <section class="pie_nombre">
                <a href="../index.html" class="logo_pie">
                    <span class="nombre_centro">
                        <strong>MRV Salud</strong>
                        <small>HOSPITAL &amp; CENTRO MÉDICO</small>
                    </span>
                </a>

                <p>
                    Medicina de excelencia con la calidez y cercanía
                    que cada persona merece.
                </p>
            </section>

            <section class="pie_columna">
                <h3>PORTAL</h3>
                <ul>
                    <li><a href="../index.html">Inicio</a></li>
                    <li><a href="especialidades.html">Especialidades</a></li>
                    <li><a href="especialistas.html">Especialistas</a></li>
                    <li><a href="contacto.html">Contacto</a></li>
                </ul>
            </section>

            <section class="pie_columna">
                <h3>PACIENTES</h3>
                <ul>
                    <li><a href="agendar_cita.html">Agendar cita</a></li>
                    <li><a href="consultar-cita.html">Consultar cita</a></li>
                </ul>
            </section>

            <section class="pie_columna">
                <h3>CONTACTO</h3>
                <ul>
                    <li><a href="tel:+50422345555">+504 2234-5555</a></li>
                    <li><a href="mailto:atencion@mrv_salud.hn">atencion@mrv_salud.hn</a></li>
                    <li>Tegucigalpa, Honduras</li>
                </ul>
            </section>
        </div>

        <!-- Parte inferior -->
        <div class="pie_inferior">
            <p>
                &copy; 2026 Centro médico MRV Salud.
                Todos los derechos reservados.
            </p>

            <div class="enlaces-legales">
                <a href="#">Privacidad</a>
                <a href="#">Términos de uso</a>
            </div>
        </div>
    </footer>


    </form>
</body>
</html>
